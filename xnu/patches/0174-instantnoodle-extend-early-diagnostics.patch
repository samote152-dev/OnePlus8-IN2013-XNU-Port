# Keep the IN2013 early framebuffer diagnostic alive beyond kprintf startup.
# The serial UART is not a usable display/log path during this bring-up test.
# Extend markers through arm_init() until machine_startup() takes over.
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -89,6 +89,6 @@
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
-	if (early_disabled || stage > 20) {
+	if (early_disabled || stage > 31) {
 		return;
 	}
@@ -95,4 +95,7 @@
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+	const unsigned int bar_slots = (EARLY_WIDTH + 47u) / 48u;
+	const unsigned int bar_x = (stage % bar_slots) * 48u;
+	const unsigned int bar_end = (bar_x + 48u < EARLY_WIDTH) ? bar_x + 48u : EARLY_WIDTH;
 	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
-		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+		for (unsigned int x = bar_x; x < bar_end; x++) {
 			EARLY_FB[y * EARLY_STRIDE + x] = color;
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -542,6 +542,3 @@
 	sweet_early_mark(20, "kprintf startup complete");
-	if (serial_exists) {
-		sweet_early_disable();
-	}
 
 	serialmode = 0;
@@ -574,5 +571,6 @@
 	if (kern_feature_override(KF_SERIAL_OVRD)) {
 		serialmode = 0;
 	}
+	sweet_early_mark(21, "serial mode configured");
 
 	/* Start serial if requested and a serial device was enumerated in serial_init(). */
@@ -585,4 +583,6 @@
 	PE_create_console();
+	sweet_early_mark(22, "console created");
 
 	/* setup console output */
 	PE_init_printf(FALSE);
+	sweet_early_mark(23, "printf console initialized");
@@ -596,3 +596,5 @@
 	cpu_machine_idle_init(TRUE);
+	sweet_early_mark(24, "machine idle initialized");
 
 	PE_init_platform(TRUE, &BootCpuData);
+	sweet_early_mark(25, "late platform init done");
@@ -606,1 +608,2 @@
 	ml_map_cpu_pio();
+	sweet_early_mark(26, "CPU PIO mapped");
@@ -614,1 +617,2 @@
 	cpu_timebase_init(TRUE);
+	sweet_early_mark(27, "CPU timebase initialized");
@@ -621,2 +625,4 @@
 	PE_init_cpu();
+	sweet_early_mark(28, "PE_init_cpu done");
 	fiq_context_init(TRUE);
+	sweet_early_mark(29, "FIQ context initialized");
@@ -649,2 +655,3 @@
 	gDramBase = *dram_base;
 	gDramSize = *dram_size;
+	sweet_early_mark(30, "DRAM properties loaded");
@@ -663,2 +670,3 @@
 	__stack_chk_guard &= ~(0xFFULL << 8);
+	sweet_early_mark(31, "entering machine_startup");
 	machine_startup(args);
