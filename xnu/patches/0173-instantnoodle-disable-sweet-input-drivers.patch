# The inherited SWEET input helpers target different hardware: the PM6150L
# key observer and Apollo/NT36675 SPI touch controller are not IN2013 devices.
# OnePlus 8 uses Samsung S6SY771 over QUPv3 SE13/I2C at 0x48 (IRQ GPIO39,
# reset GPIO38). Keep both helpers uncalled until native IN2013 drivers exist.
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -601,6 +601,10 @@
 	sweet_log_start();
 	sweet_sample_start();
 	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
+#if !defined(INSTANTNOODLE)
 	sweet_keys_init();
 	sweet_touch_init();
+#else
+	printf("INSTANTNOODLE: SWEET PMIC keys and Apollo NT36675 SPI touch disabled; native S6SY771 I2C driver pending\n");
+#endif
 	return 0;
