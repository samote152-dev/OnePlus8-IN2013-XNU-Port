# IN2013 has a different touch/input stack from SWEET/MI10T Apollo.
# Do not probe the inherited SWEET key/touch helpers until their GPIO, IRQ,
# clocks and controller assumptions are validated on the OnePlus 8.
# Keep the IN2013 UFS root, persistent console log and software sampler.
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -656,6 +656,8 @@ sweet_ufs_init(void)
 	sweet_log_start();
 	sweet_sample_start();
 	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
+#if !defined(INSTANTNOODLE)
 	sweet_keys_init();
 	sweet_touch_init();
+#endif
 	return 0;
 }
