diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 2545cf9..ec7e724 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -73,7 +73,7 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
-	/* MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
+	/* MPIDR Aff1 = core: IN2013 order is 0-3 A55, 4-6 A77, 7 A77 prime. */
 	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
 	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
@@ -82,7 +82,11 @@ SweetCPU::start(IOService *provider)
 	if (!IOCPU::start(provider)) {
 		return false;
 	}
+	#if defined(INSTANTNOODLE)
+	cpuName = OSSymbol::withCStringNoCopy("Kryo 585");
+#else
 	cpuName = OSSymbol::withCStringNoCopy("Kryo 470");
+#endif
 	if (cpuName == NULL) {
 		return false;
 	}
@@ -144,7 +148,7 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 		}
 		IOSleep(1);
 	}
-	/* The supplied ADT has cpu0 as the boot CPU and ascending A55 nodes. */
+	/* The supplied ADT has cpu0 as the boot CPU and nodes in ascending MPIDR order. */
 	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0) {
 		panic("SWEET CPU: expected boot MPIDR 0 and logical CPU 0");
 	}
diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
