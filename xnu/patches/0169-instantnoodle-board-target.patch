diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index e20709b..49b20b3 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -663,6 +663,14 @@ sweet_ufs_init(void)
 	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
+#if defined(INSTANTNOODLE)
+	/* IN2013 first-boot profile: do not run Xiaomi Mi 10T GPIO, SPI touch,
+	 * PMIC, GPU, Wi-Fi, Bluetooth, audio or backlight code on this board.
+	 * Each peripheral is enabled only after its IN2013 backend is validated. */
+	sweet_log_start();
+	sweet_sample_start();
+	printf("IN2013: SM8250/UFS path active; board peripherals deliberately deferred\n");
+#else
 	/* CPU clock first: firmware leaves the cores slow (apollo, sweet_cpufreq.c). */
 	sweet_cpufreq_init();
 	/* Adreno 650 probe; does nothing without boot-arg sweetgpu=N (sweet_gpu.c). */
@@ -688,6 +696,7 @@ sweet_ufs_init(void)
 	apollo_haptic_init();
 	/* the backlight (xnu 0151, sweet_backlight.c): faded out and in with the display (boot-arg apollo_backlight=0: left alone) */
 	apollo_backlight_init();
+#endif
 	return 0;
 }
 
