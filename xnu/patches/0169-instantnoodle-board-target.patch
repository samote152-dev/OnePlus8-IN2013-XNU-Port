@@ -437,6 +437,9 @@ SweetHIDTouch::start(IOService *provider)
 		return false;
 	}
 	int native = 0;
+#if defined(INSTANTNOODLE)
+	native = 1;
+#endif
 	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
 	fLogicalW = native ? 1080 : 1125;
 	fLogicalH = native ? 2400 : 2436;
