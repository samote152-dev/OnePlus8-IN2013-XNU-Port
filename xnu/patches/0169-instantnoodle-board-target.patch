+#  PERF_DBG_RELEASE=[ PERF_DBG_BASE ist_kdebug ]
+#  PERF_DBG_DEV =   [ PERF_DBG_BASE lock_stats zleaks alternate_debugger sched_hygiene_debug config_debug_syscall_rejection config_iotrace ]
