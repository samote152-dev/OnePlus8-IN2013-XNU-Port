# Extend IN2013 early diagnostics into machine_startup() and kernel_bootstrap().
# Follows marker 31 ("entering machine_startup") to isolate the next stall.
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -91,1 +91,1 @@
-	if (early_disabled || stage > 31) {
+	if (early_disabled || stage > 40) {
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -30,1 +30,2 @@
 #include <arm64/machine_machdep.h>
+#include <arm64/sweet_early.h>
@@ -476,2 +477,3 @@
 machine_startup(__unused boot_args * args)
 {
+	sweet_early_mark(32, "machine_startup entered");
@@ -485,1 +487,2 @@
 	machine_conf();
+	sweet_early_mark(33, "machine_conf done");
@@ -489,2 +492,3 @@
 	 */
+	sweet_early_mark(34, "calling kernel_bootstrap");
 	kernel_bootstrap();
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -79,1 +79,2 @@
 #include <debug.h>
+#include <arm64/sweet_early.h>
@@ -422,5 +423,6 @@
 kernel_bootstrap(void)
 {
 	kern_return_t   result;
 	thread_t        thread;
 	char            namep[16];
+	sweet_early_mark(35, "kernel_bootstrap entered");
@@ -432,1 +434,2 @@
 	scale_setup();
+	sweet_early_mark(36, "scale_setup done");
@@ -436,1 +439,2 @@
 	vm_mem_bootstrap();
+	sweet_early_mark(37, "vm_mem_bootstrap done");
@@ -476,1 +480,2 @@
 	console_init();
+	sweet_early_mark(38, "console_init done");
@@ -482,1 +487,2 @@
 	sched_init();
+	sweet_early_mark(39, "sched_init done");
@@ -496,1 +502,2 @@
 	PMAP_ACTIVATE_KERNEL(master_cpu);
+	sweet_early_mark(40, "kernel pmap activated");
