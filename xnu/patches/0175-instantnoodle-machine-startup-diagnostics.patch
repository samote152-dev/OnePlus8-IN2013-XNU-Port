# Extend IN2013 early diagnostics into machine_startup() and kernel_bootstrap().
# Corrected against the XNU buildtree from failed run #185; preserves declarations before statements.
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -89,7 +89,7 @@
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
-	if (early_disabled || stage > 31) {
+	if (early_disabled || stage > 40) {
 		return;
 	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -27,6 +27,7 @@
  */
 
 #include <arm64/machine_machdep.h>
+#include <arm64/sweet_early.h>
 #include <arm64/proc_reg.h>
 #include <arm/machine_cpu.h>
 #include <arm/cpu_internal.h>
@@ -476,6 +477,7 @@
 void
 machine_startup(__unused boot_args * args)
 {
+	sweet_early_mark(32, "machine_startup entered");
 #if defined(HAS_IPI) && (DEVELOPMENT || DEBUG)
 	if (!PE_parse_boot_argn("fastipi", &gFastIPI, sizeof(gFastIPI))) {
 		gFastIPI = 1;
@@ -484,11 +486,13 @@
 
 
 	machine_conf();
+	sweet_early_mark(33, "machine_conf done");
 
 
 	/*
 	 * Kick off the kernel bootstrap.
 	 */
+	sweet_early_mark(34, "calling kernel_bootstrap");
 	kernel_bootstrap();
 	/* NOTREACHED */
 }
